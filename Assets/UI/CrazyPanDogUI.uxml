<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/CrazyPanDogUI.uss?fileID=7433441132597879392&amp;guid=13c0427b0d8b64f3cb637ba695409138&amp;type=3#CrazyPanDogUI"/>
    <ui:VisualElement name="start-screen" picking-mode="Ignore" class="start-screen">
        <ui:Button name="btn-profile" class="profile-chip">
            <ui:Label name="label-profile-name" text="Player" class="profile-chip-label"/>
        </ui:Button>
        <ui:VisualElement picking-mode="Ignore" class="title-wrap">
            <ui:VisualElement picking-mode="Ignore" class="title-image"/>
        </ui:VisualElement>
        <ui:Label name="play-prompt" text="hold space or hold screen to rotate" class="play-prompt"/>
        <ui:VisualElement picking-mode="Ignore" class="start-bottom-bar">
            <ui:Button name="btn-options" class="corner-btn">
                <ui:Label text="OPTIONS" class="corner-btn-label"/>
            </ui:Button>
            <ui:Button name="btn-leaderboard" class="corner-btn">
                <ui:Label text="SCORES" class="corner-btn-label"/>
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="options-overlay" picking-mode="Ignore" class="overlay hidden">
        <ui:VisualElement class="overlay-panel">
            <ui:Label text="OPTIONS" class="overlay-title"/>
            <ui:VisualElement class="option-row">
                <ui:Label text="SOUND" class="option-label"/>
                <ui:Slider name="slider-sound" low-value="0" high-value="100" value="80" class="option-slider"/>
            </ui:VisualElement>
            <ui:VisualElement class="option-row">
                <ui:Label text="NAME" class="option-label"/>
                <ui:TextField name="input-player-name" value="Player" max-length="12" class="option-textfield"/>
            </ui:VisualElement>
            <ui:Button name="btn-options-close" class="overlay-close-btn">
                <ui:Label text="BACK" class="overlay-close-label"/>
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="leaderboard-overlay" picking-mode="Ignore" class="overlay hidden">
        <ui:VisualElement class="overlay-panel">
            <ui:Label text="SCORES" class="overlay-title"/>
            <ui:VisualElement name="leaderboard-list" class="leaderboard-list"/>
            <ui:Button name="btn-leaderboard-close" class="overlay-close-btn">
                <ui:Label text="BACK" class="overlay-close-label"/>
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="game-over-overlay" picking-mode="Ignore" class="overlay overlay-game-over hidden">
        <ui:VisualElement class="game-over-card">
            <ui:VisualElement name="game-over-score-block" class="game-over-score-block">
                <ui:Label name="game-over-score" text="0.0" class="game-over-score"/>
                <ui:Label name="game-over-score-sub" text="MAX HEIGHT" class="game-over-score-sub"/>
            </ui:VisualElement>
            <ui:VisualElement name="game-over-angle-row" picking-mode="Ignore" class="game-over-angle-row hidden">
                <ui:Label name="game-over-angle-caption" text="LANDING ANGLE" class="game-over-angle-caption"/>
                <ui:VisualElement picking-mode="Ignore" class="game-over-angle-values">
                    <ui:Label name="game-over-angle-value" text="0°" class="game-over-angle-value"/>
                    <ui:Label name="game-over-angle-safe" text="SAFE ±25°" class="game-over-angle-safe"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="game-over-rank-badge" class="game-over-rank-badge hidden">
                <ui:Label name="game-over-rank-caption" text="YOUR RANK" class="game-over-rank-caption"/>
                <ui:VisualElement name="game-over-rank-value-row" class="game-over-rank-value-row">
                    <ui:Label name="game-over-rank-hash" text="#" class="game-over-rank-hash"/>
                    <ui:Label name="game-over-rank-number" text="1" class="game-over-rank-number"/>
                </ui:VisualElement>
                <ui:Label name="game-over-rank-fallback" text="" class="game-over-rank-fallback hidden"/>
            </ui:VisualElement>
            <ui:Label name="end-new-best" text="NEW BEST!" class="end-new-best hidden"/>
            <ui:VisualElement name="game-over-leaderboard-list" class="leaderboard-list game-over-leaderboard"/>
            <ui:VisualElement name="game-over-extra-stats" picking-mode="Ignore" class="game-over-extra-stats hidden">
                <ui:VisualElement picking-mode="Ignore" class="end-stat-row">
                    <ui:Label text="TOTAL FLIPS" class="end-stat-label"/>
                    <ui:Label name="end-stat-flips" text="0" class="end-stat-value"/>
                </ui:VisualElement>
                <ui:VisualElement picking-mode="Ignore" class="end-stat-row">
                    <ui:Label text="PERFECT" class="end-stat-label"/>
                    <ui:Label name="end-stat-perfect" text="0" class="end-stat-value end-stat-value-accent"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement picking-mode="Ignore" class="game-over-divider"/>
            <ui:Button name="btn-game-over-restart" class="game-over-restart-btn">
                <ui:Label text="TRY AGAIN" class="game-over-restart-label"/>
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="game-hud" picking-mode="Ignore" class="game-hud hidden">
        <ui:VisualElement name="altitude-hud-wrap" picking-mode="Ignore" class="altitude-hud-wrap">
            <ui:Label name="altitude-label" text="" class="altitude-label"/>
        </ui:VisualElement>
        <ui:VisualElement name="score-wrap" picking-mode="Ignore" class="score-wrap">
            <ui:Label name="score-label" text="0" class="score-label"/>
            <ui:Label text="FLIPS" class="score-sub-label"/>
        </ui:VisualElement>
        <ui:VisualElement name="combo-root" picking-mode="Ignore" class="combo-root"/>
    </ui:VisualElement>
    <ui:VisualElement name="game-end-overlay" picking-mode="Ignore" class="overlay overlay-game-end hidden">
        <ui:VisualElement name="game-end-credits" picking-mode="Ignore" class="game-end-credits hidden">
            <ui:VisualElement picking-mode="Ignore" class="credits-box">
                <ui:Label text="You did it!" class="credits-headline"/>
                <ui:Label text="Credits" class="credits-heading"/>
                <ui:VisualElement picking-mode="Ignore" class="credits-row">
                    <ui:Label text="David Paßberger" class="credits-name"/>
                    <ui:Label text="Audio" class="credits-role"/>
                </ui:VisualElement>
                <ui:VisualElement picking-mode="Ignore" class="credits-row">
                    <ui:Label text="Marlon Popp" class="credits-name"/>
                    <ui:Label text="Art" class="credits-role"/>
                </ui:VisualElement>
                <ui:VisualElement picking-mode="Ignore" class="credits-row">
                    <ui:Label text="Markus Meier" class="credits-name"/>
                    <ui:Label text="Tech Art" class="credits-role"/>
                </ui:VisualElement>
                <ui:VisualElement picking-mode="Ignore" class="credits-row">
                    <ui:Label text="Mehdi Popal" class="credits-name"/>
                    <ui:Label text="Programming" class="credits-role"/>
                </ui:VisualElement>
                <ui:Label text="Special Thanks to our Playtesters!" class="credits-thanks-line"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="cheering-crowd" picking-mode="Ignore" class="cheering-crowd">
        <ui:VisualElement name="cheering-man" picking-mode="Ignore" class="cheering-person cheering-person--man hidden"/>
        <ui:VisualElement name="cheering-girl" picking-mode="Ignore" class="cheering-person cheering-person--girl hidden"/>
        <ui:VisualElement name="cheering-alien" picking-mode="Ignore" class="cheering-person cheering-person--alien hidden"/>
    </ui:VisualElement>
</ui:UXML>
