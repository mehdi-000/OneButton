.minimap-chrome {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: row;
    padding: 3px;
    overflow: hidden;
    background-color: rgba(6, 10, 22, 1);
    border-width: 3px;
    border-color: rgba(130, 185, 255, 0.9);
    border-radius: 50%;
    opacity: 0;
    scale: 0.7 0.7;
    transition-property: opacity, scale;
    transition-duration: 0.3s, 0.35s;
    transition-timing-function: ease-out, ease-out;
}

.minimap-chrome.minimap-visible {
    opacity: 1;
    scale: 1 1;
}

.minimap-close-view {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background-color: rgba(6, 10, 22, 1);
}
