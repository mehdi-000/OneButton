/* ═══════════════════════════════════════════════
   CRAZY PAN DOG – RESPONSIVE UI
   Reference: 1080 × 1920, width-based scaling
   ═══════════════════════════════════════════════ */

.hidden {
    display: none;
}

/* ═══════════ START SCREEN ═══════════ */
.start-screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-left: 6%;
    padding-right: 6%;
    padding-top: 4%;
    padding-bottom: 4%;
    overflow: hidden;
}

.title-wrap {
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: 4%;
    overflow: visible;
}

.title-label {
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.title-line-1 {
    font-size: 58px;
    color: rgb(210, 100, 40);
    text-shadow: 3px 4px 0 rgb(80, 30, 5);
    rotate: -6deg;
    margin-bottom: -6px;
}

.title-line-2 {
    font-size: 66px;
    color: rgb(90, 60, 160);
    text-shadow: 3px 5px 0 rgb(30, 15, 70);
    rotate: 3deg;
    margin-bottom: -6px;
}

.title-line-3 {
    font-size: 72px;
    color: rgb(80, 160, 60);
    text-shadow: 3px 5px 0 rgb(25, 60, 15);
    rotate: -4deg;
}

/* play prompt */
.play-prompt {
    margin-top: 5%;
    font-size: 20px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.85);
    -unity-text-align: middle-center;
    text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.5);
    letter-spacing: 2px;
    white-space: normal;
    flex-shrink: 0;
}

.play-prompt.pulse-dim {
    color: rgba(255, 255, 255, 0.3);
}

/* bottom corner buttons */
.start-bottom-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
    justify-content: space-between;
    padding-left: 5%;
    padding-right: 5%;
    padding-bottom: 5%;
}

.corner-btn {
    background-color: rgba(0, 0, 0, 0.35);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.2);
    border-radius: 14px;
    padding: 8px 16px;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.12s;
}

.corner-btn:hover {
    background-color: rgba(255, 200, 60, 0.3);
    border-color: rgba(255, 200, 60, 0.6);
    scale: 1.05 1.05;
}

.corner-btn:active {
    background-color: rgba(255, 200, 60, 0.5);
    scale: 0.94 0.94;
}

.corner-btn-label {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.9);
    letter-spacing: 2px;
    -unity-text-align: middle-center;
}

/* ═══════════ OVERLAY SHARED ═══════════ */
.overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.7);
    align-items: center;
    justify-content: center;
    padding: 6%;
}

.overlay-panel {
    width: 88%;
    max-width: 420px;
    background-color: rgba(20, 15, 35, 0.96);
    border-width: 2px;
    border-color: rgba(255, 200, 60, 0.35);
    border-radius: 20px;
    padding: 22px 18px 18px 18px;
    flex-direction: column;
    align-items: center;
}

.overlay-title {
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(255, 200, 60);
    -unity-text-align: middle-center;
    letter-spacing: 4px;
    margin-bottom: 14px;
    text-shadow: 2px 3px 0 rgb(40, 20, 0);
}

.overlay-close-btn {
    margin-top: 16px;
    background-color: rgba(255, 165, 0, 0.22);
    border-width: 2px;
    border-color: rgba(255, 200, 60, 0.45);
    border-radius: 12px;
    padding: 8px 20%;
    transition-property: background-color, scale;
    transition-duration: 0.12s;
}

.overlay-close-btn:hover {
    background-color: rgba(255, 165, 0, 0.4);
    scale: 1.04 1.04;
}

.overlay-close-btn:active {
    background-color: rgba(255, 165, 0, 0.6);
    scale: 0.95 0.95;
}

.overlay-close-label {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    letter-spacing: 3px;
    -unity-text-align: middle-center;
}

/* ═══════════ OPTIONS ═══════════ */
.option-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    margin-bottom: 12px;
}

.option-label {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(220, 220, 230);
    width: 28%;
    letter-spacing: 2px;
}

.option-slider {
    flex-grow: 1;
    margin-left: 8px;
}

.option-slider .unity-base-slider__dragger {
    width: 28px;
    height: 28px;
    border-radius: 14px;
    background-color: rgb(255, 200, 60);
    border-width: 2px;
    border-color: rgb(200, 140, 20);
}

.option-textfield {
    flex-grow: 1;
    margin-left: 8px;
}

.option-textfield .unity-text-field__input {
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 2px;
    border-color: rgba(255, 200, 60, 0.35);
    border-radius: 10px;
    padding: 6px 10px;
    color: rgb(240, 240, 250);
    font-size: 16px;
    -unity-font-style: bold;
}

.option-slider .unity-base-slider__tracker {
    height: 8px;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.15);
    margin-top: -4px;
}

/* ═══════════ LEADERBOARD ═══════════ */
.leaderboard-list {
    width: 100%;
    flex-direction: column;
}

.leaderboard-row {
    flex-direction: row;
    align-items: center;
    padding: 6px 10px;
    margin-bottom: 2px;
    border-radius: 8px;
    background-color: rgba(255, 255, 255, 0.04);
}

.leaderboard-row-top {
    background-color: rgba(255, 200, 60, 0.1);
}

.leaderboard-rank {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgba(255, 200, 60, 0.85);
    width: 32px;
    min-width: 32px;
    -unity-text-align: middle-left;
}

.leaderboard-name {
    font-size: 14px;
    color: rgba(220, 225, 240, 0.85);
    flex-grow: 1;
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
}

.leaderboard-score {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(255, 200, 60);
    -unity-text-align: middle-right;
    min-width: 36px;
}

/* ═══════════ GAME OVER ═══════════ */
.overlay-game-over {
    background-color: rgba(10, 5, 18, 0.78);
}

.game-over-card {
    flex-direction: column;
    align-items: center;
    padding: 8% 10%;
    background-color: rgba(18, 10, 32, 0.95);
    border-width: 3px;
    border-color: rgba(255, 200, 60, 0.5);
    border-radius: 28px;
    max-width: 380px;
    width: 78%;
}

.game-over-score {
    font-size: 60px;
    -unity-font-style: bold;
    color: rgb(255, 220, 60);
    -unity-text-align: middle-center;
    text-shadow: 0 4px 0 rgb(50, 25, 0);
    letter-spacing: 2px;
    margin-bottom: -4px;
}

.game-over-score-sub {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgba(255, 220, 60, 0.6);
    letter-spacing: 6px;
    -unity-text-align: middle-center;
    margin-bottom: 12px;
}

.game-over-stat-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
}

.game-over-height {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(180, 220, 255);
    -unity-text-align: middle-center;
    text-shadow: 0 2px 0 rgb(15, 30, 60);
    letter-spacing: 1px;
}

.game-over-divider {
    width: 60%;
    height: 2px;
    background-color: rgba(255, 200, 60, 0.22);
    border-radius: 1px;
    margin-bottom: 18px;
}

.game-over-restart-btn {
    width: 100%;
    background-color: rgba(255, 200, 60, 0.18);
    border-width: 2px;
    border-color: rgba(255, 200, 60, 0.6);
    border-radius: 18px;
    padding: 14px 10px;
    transition-property: background-color, scale, border-color;
    transition-duration: 0.12s;
}

.game-over-restart-btn:hover {
    background-color: rgba(255, 200, 60, 0.35);
    border-color: rgb(255, 220, 100);
    scale: 1.04 1.04;
}

.game-over-restart-btn:active {
    background-color: rgba(255, 200, 60, 0.5);
    scale: 0.95 0.95;
}

.game-over-restart-label {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    letter-spacing: 4px;
    -unity-text-align: middle-center;
}

/* ═══════════ IN-GAME HUD ═══════════ */
.game-hud {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* score top-right */
.score-wrap {
    position: absolute;
    right: 4%;
    top: 3%;
    flex-direction: column;
    align-items: flex-end;
}

.score-label {
    font-size: 38px;
    -unity-font-style: bold;
    color: rgb(255, 220, 60);
    -unity-text-align: upper-right;
    text-shadow: 2px 3px 0 rgb(40, 20, 0);
}

.score-sub-label {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgba(255, 220, 60, 0.55);
    letter-spacing: 4px;
    margin-top: -4px;
    -unity-text-align: upper-right;
}

/* altitude top-left */
.altitude-hud-wrap {
    position: absolute;
    left: 4%;
    top: 3%;
    align-items: flex-start;
}

.altitude-label {
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(210, 235, 255);
    -unity-text-align: upper-left;
    text-shadow: 2px 3px 0 rgb(15, 25, 55);
}


/* world-space flip combo (renders behind player) */
.flip-combo-world-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.live-flip-wrap.live-flip-wrap--world {
    position: relative;
    left: auto;
    right: auto;
    top: auto;
    width: 100%;
    align-items: center;
    transition-property: none;
}

.live-flip-wrap.live-flip-wrap--world.live-flip-wrap--lens-active .live-flip-bar {
    scale: 0.8 0.8;
    transition-property: scale;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
}

/* combo root */
.combo-root {
    flex-grow: 1;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding-top: 22%;
}

/* ═══════════════════════════════════════════════
   LIVE FLIP COUNTER  (in-jump combo)
   tier escalation: zero → low → mid → high → hype → god
   Colors echo title palette (orange / purple / green / gold)
   ═══════════════════════════════════════════════ */

.live-flip-wrap {
    position: absolute;
    left: 0;
    right: 0;
    top: 9%;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    transition-property: top;
    transition-duration: 0.35s;
    transition-timing-function: ease-out;
}

.live-flip-bar {
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    scale: 0.40 0.40;
}

.live-flip-stack {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    min-width: 200px;
    min-height: 110px;
}

.live-flip-aura {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 220px;
    height: 220px;
    margin-left: -110px;
    margin-top: -110px;
    border-radius: 110px;
    opacity: 0;
    background-color: rgba(255, 200, 60, 0);
    transition-property: background-color, opacity, scale;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
}

.live-flip-aura-outer {
    width: 320px;
    height: 320px;
    margin-left: -160px;
    margin-top: -160px;
    border-radius: 160px;
}

/* tier-live-zero — hidden */
.live-flip-aura.tier-live-zero { opacity: 0; scale: 0.5 0.5; }

/* tier-low (1 flip) — cool cyan */
.live-flip-aura-inner.tier-low {
    opacity: 0.50;
    background-color: rgba(90, 190, 255, 0.7);
    scale: 0.70 0.70;
}
.live-flip-aura-outer.tier-low {
    opacity: 0.20;
    background-color: rgba(90, 190, 255, 0.5);
    scale: 0.55 0.55;
}

/* tier-mid (2-4) — game gold */
.live-flip-aura-inner.tier-mid {
    opacity: 0.65;
    background-color: rgba(255, 190, 50, 0.85);
    scale: 0.85 0.85;
}
.live-flip-aura-outer.tier-mid {
    opacity: 0.28;
    background-color: rgba(255, 165, 0, 0.6);
    scale: 0.72 0.72;
}

/* tier-high (5-9) — game orange (title color) */
.live-flip-aura-inner.tier-high {
    opacity: 0.78;
    background-color: rgba(255, 120, 50, 0.9);
    scale: 1.0 1.0;
}
.live-flip-aura-outer.tier-high {
    opacity: 0.36;
    background-color: rgba(255, 90, 130, 0.7);
    scale: 0.86 0.86;
}

/* tier-hype (10-19) — magenta / purple (title purple) */
.live-flip-aura-inner.tier-hype {
    opacity: 0.90;
    background-color: rgba(255, 80, 200, 0.92);
    scale: 1.18 1.18;
}
.live-flip-aura-outer.tier-hype {
    opacity: 0.46;
    background-color: rgba(160, 60, 220, 0.78);
    scale: 1.02 1.02;
}

/* tier-god (20+) — green/purple electric (title green) */
.live-flip-aura-inner.tier-god {
    opacity: 1.0;
    background-color: rgba(140, 230, 90, 0.95);
    scale: 1.35 1.35;
}
.live-flip-aura-outer.tier-god {
    opacity: 0.55;
    background-color: rgba(170, 110, 255, 0.85);
    scale: 1.22 1.22;
}

/* the big number itself */
.live-flip-label {
    font-size: 92px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 245, 200);
    letter-spacing: 2px;
    text-shadow: 0 4px 0 rgb(35, 15, 60);
    transition-property: color, font-size, letter-spacing;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

.live-flip-label.tier-live-zero {
    font-size: 46px;
    opacity: 0;
    color: rgb(180, 200, 220);
}

.live-flip-label.tier-low {
    font-size: 70px;
    color: rgb(200, 245, 255);
    text-shadow: 0 4px 0 rgb(10, 40, 70);
}

.live-flip-label.tier-mid {
    font-size: 86px;
    color: rgb(255, 230, 100);
    letter-spacing: 3px;
    text-shadow: 0 5px 0 rgb(80, 35, 0);
}

.live-flip-label.tier-high {
    font-size: 102px;
    color: rgb(255, 165, 80);
    letter-spacing: 5px;
    text-shadow: 0 6px 0 rgb(90, 30, 5);
}

.live-flip-label.tier-hype {
    font-size: 116px;
    color: rgb(255, 130, 230);
    letter-spacing: 7px;
    text-shadow: 0 7px 0 rgb(60, 0, 80);
}

.live-flip-label.tier-god {
    font-size: 130px;
    color: rgb(190, 255, 150);
    letter-spacing: 9px;
    text-shadow: 0 8px 0 rgb(40, 0, 90);
}

/* progress bar to next flip */
.live-flip-meter {
    margin-top: 14px;
    width: 50%;
    height: 10px;
    border-radius: 5px;
    background-color: rgba(20, 15, 40, 0.55);
    border-width: 1px;
    border-color: rgba(255, 220, 130, 0.22);
    overflow: hidden;
}

.live-flip-meter-fill {
    width: 0%;
    height: 100%;
    border-radius: 5px;
    background-color: rgb(255, 200, 60);
    transition-property: background-color;
    transition-duration: 0.2s;
}

.live-flip-meter-fill.tier-live-zero { background-color: rgba(200, 220, 240, 0.45); }
.live-flip-meter-fill.tier-low       { background-color: rgb(140, 220, 255); }
.live-flip-meter-fill.tier-mid       { background-color: rgb(255, 220, 90); }
.live-flip-meter-fill.tier-high      { background-color: rgb(255, 140, 80); }
.live-flip-meter-fill.tier-hype      { background-color: rgb(255, 110, 220); }
.live-flip-meter-fill.tier-god       { background-color: rgb(180, 255, 130); }

/* milestone banner that pops at 5 / 10 / 20 / 50 / 100 */
.live-flip-milestone {
    margin-top: 18px;
    font-size: 34px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    letter-spacing: 8px;
    text-shadow: 0 4px 0 rgb(40, 0, 60);
    opacity: 0;
    white-space: nowrap;
}

.live-flip-milestone.ms-1 {
    font-size: 32px;
    color: rgb(255, 230, 100);
    text-shadow: 0 4px 0 rgb(80, 35, 0);
}

.live-flip-milestone.ms-2 {
    font-size: 38px;
    color: rgb(255, 165, 70);
    text-shadow: 0 5px 0 rgb(90, 30, 0);
}

.live-flip-milestone.ms-3 {
    font-size: 46px;
    color: rgb(255, 120, 220);
    letter-spacing: 10px;
    text-shadow: 0 6px 0 rgb(60, 0, 70);
}

.live-flip-milestone.ms-4 {
    font-size: 54px;
    color: rgb(190, 255, 140);
    letter-spacing: 12px;
    text-shadow: 0 6px 0 rgb(40, 0, 90);
}

.live-flip-milestone.ms-5 {
    font-size: 64px;
    color: rgb(255, 245, 200);
    letter-spacing: 14px;
    text-shadow: 0 8px 0 rgb(60, 0, 100);
}

.live-flip-label.idle-flash {
    color: rgb(255, 140, 160);
}

/* ═══════════════════════════════════════════════
   COMBO POPUP (on landing)
   ═══════════════════════════════════════════════ */
.combo-popup-label {
    position: relative;
    font-size: 68px;
    -unity-font-style: bold;
    color: rgb(255, 240, 120);
    -unity-text-align: middle-center;
    letter-spacing: 2px;
    text-shadow: 0 4px 0 rgb(30, 10, 60);
}

.combo-popup-label.tier-low {
    color: rgb(180, 240, 255);
    font-size: 56px;
    text-shadow: 0 4px 0 rgb(10, 40, 60);
}

.combo-popup-label.tier-mid {
    color: rgb(255, 220, 90);
    font-size: 70px;
    letter-spacing: 3px;
    text-shadow: 0 5px 0 rgb(80, 35, 0);
}

.combo-popup-label.tier-high {
    color: rgb(255, 150, 70);
    font-size: 86px;
    letter-spacing: 5px;
    text-shadow: 0 6px 0 rgb(90, 25, 5);
}

.combo-popup-label.tier-hype {
    color: rgb(255, 100, 220);
    font-size: 102px;
    letter-spacing: 7px;
    text-shadow: 0 7px 0 rgb(60, 0, 80);
}

.combo-popup-label.tier-god {
    color: rgb(180, 255, 130);
    font-size: 118px;
    letter-spacing: 9px;
    text-shadow: 0 8px 0 rgb(40, 0, 90);
}

.combo-popup-perfect {
    position: relative;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    font-size: 24px;
    color: rgb(150, 255, 130);
    letter-spacing: 7px;
    margin-bottom: 4px;
    text-shadow: 0 3px 0 rgb(25, 60, 15);
    rotate: -4deg;
}

.combo-popup-sub {
    position: relative;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    font-size: 26px;
    color: rgb(255, 255, 255);
    letter-spacing: 6px;
    margin-top: -6px;
    text-shadow: 0 3px 0 rgb(40, 0, 60);
}

.combo-popup-sub.tier-mid { color: rgb(255, 230, 120); text-shadow: 0 3px 0 rgb(80, 35, 0); }
.combo-popup-sub.tier-high { color: rgb(255, 175, 90); font-size: 30px; }
.combo-popup-sub.tier-hype { color: rgb(255, 140, 230); font-size: 36px; letter-spacing: 10px; }
.combo-popup-sub.tier-god { color: rgb(200, 255, 160); font-size: 42px; letter-spacing: 12px; }

/* ═══════════ CHEERING CROWD (screen-space) ═══════════ */
.cheering-crowd {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    picking-mode: Ignore;
    overflow: visible;
}

.cheering-person {
    position: absolute;
    bottom: 0%;
    width: 62%;
    height: 78%;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    opacity: 1;
    translate: 0 0;
}

.cheering-person--man {
    left: -5%;
    bottom: -20%;
}

.cheering-person--girl {
    right: -10%;
    bottom: -22%;
    width: 62%;
    height: 78%;
}

.cheering-person--alien {
    right: -2%;
    bottom: 18%;
    width: 62%;
    height: 78%;
}