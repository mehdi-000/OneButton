/* ═══════════════════════════════════════════════
   CRAZY PAN DOG – RESPONSIVE UI
   Reference: 1080 × 1920, width-based scaling
   ═══════════════════════════════════════════════ */

.hidden {
    display: none;
}

/* ═══════════ START SCREEN ═══════════ */
.start-screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-left: 6%;
    padding-right: 6%;
    padding-top: 4%;
    padding-bottom: 4%;
    overflow: hidden;
}

.title-wrap {
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: 4%;
    overflow: visible;
}

.title-label {
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.title-line-1 {
    font-size: 58px;
    color: rgb(210, 100, 40);
    text-shadow: 3px 4px 0 rgb(80, 30, 5);
    rotate: -6deg;
    margin-bottom: -6px;
}

.title-line-2 {
    font-size: 66px;
    color: rgb(90, 60, 160);
    text-shadow: 3px 5px 0 rgb(30, 15, 70);
    rotate: 3deg;
    margin-bottom: -6px;
}

.title-line-3 {
    font-size: 72px;
    color: rgb(80, 160, 60);
    text-shadow: 3px 5px 0 rgb(25, 60, 15);
    rotate: -4deg;
}

/* play prompt */
.play-prompt {
    margin-top: 5%;
    font-size: 20px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.85);
    -unity-text-align: middle-center;
    text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.5);
    letter-spacing: 2px;
    white-space: normal;
    flex-shrink: 0;
}

.play-prompt.pulse-dim {
    color: rgba(255, 255, 255, 0.3);
}

/* bottom corner buttons */
.start-bottom-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
    justify-content: space-between;
    padding-left: 5%;
    padding-right: 5%;
    padding-bottom: 5%;
}

.corner-btn {
    background-color: rgba(0, 0, 0, 0.35);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.2);
    border-radius: 14px;
    padding: 8px 16px;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.12s;
}

.corner-btn:hover {
    background-color: rgba(255, 200, 60, 0.3);
    border-color: rgba(255, 200, 60, 0.6);
    scale: 1.05 1.05;
}

.corner-btn:active {
    background-color: rgba(255, 200, 60, 0.5);
    scale: 0.94 0.94;
}

.corner-btn-label {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.9);
    letter-spacing: 2px;
    -unity-text-align: middle-center;
}

/* ═══════════ OVERLAY SHARED ═══════════ */
.overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.7);
    align-items: center;
    justify-content: center;
    padding: 6%;
}

.overlay-panel {
    width: 88%;
    max-width: 420px;
    background-color: rgba(20, 15, 35, 0.96);
    border-width: 2px;
    border-color: rgba(255, 200, 60, 0.35);
    border-radius: 20px;
    padding: 22px 18px 18px 18px;
    flex-direction: column;
    align-items: center;
}

.overlay-title {
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(255, 200, 60);
    -unity-text-align: middle-center;
    letter-spacing: 4px;
    margin-bottom: 14px;
    text-shadow: 2px 3px 0 rgb(40, 20, 0);
}

.overlay-close-btn {
    margin-top: 16px;
    background-color: rgba(255, 165, 0, 0.22);
    border-width: 2px;
    border-color: rgba(255, 200, 60, 0.45);
    border-radius: 12px;
    padding: 8px 20%;
    transition-property: background-color, scale;
    transition-duration: 0.12s;
}

.overlay-close-btn:hover {
    background-color: rgba(255, 165, 0, 0.4);
    scale: 1.04 1.04;
}

.overlay-close-btn:active {
    background-color: rgba(255, 165, 0, 0.6);
    scale: 0.95 0.95;
}

.overlay-close-label {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    letter-spacing: 3px;
    -unity-text-align: middle-center;
}

/* ═══════════ OPTIONS ═══════════ */
.option-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    margin-bottom: 12px;
}

.option-label {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(220, 220, 230);
    width: 28%;
    letter-spacing: 2px;
}

.option-slider {
    flex-grow: 1;
    margin-left: 8px;
}

.option-slider .unity-base-slider__dragger {
    width: 28px;
    height: 28px;
    border-radius: 14px;
    background-color: rgb(255, 200, 60);
    border-width: 2px;
    border-color: rgb(200, 140, 20);
}

.option-textfield {
    flex-grow: 1;
    margin-left: 8px;
}

.option-textfield .unity-text-field__input {
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 2px;
    border-color: rgba(255, 200, 60, 0.35);
    border-radius: 10px;
    padding: 6px 10px;
    color: rgb(240, 240, 250);
    font-size: 16px;
    -unity-font-style: bold;
}

.option-slider .unity-base-slider__tracker {
    height: 8px;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.15);
    margin-top: -4px;
}

/* ═══════════ LEADERBOARD ═══════════ */
.leaderboard-list {
    width: 100%;
    flex-direction: column;
}

.leaderboard-row {
    flex-direction: row;
    align-items: center;
    padding: 6px 10px;
    margin-bottom: 2px;
    border-radius: 8px;
    background-color: rgba(255, 255, 255, 0.04);
}

.leaderboard-row-top {
    background-color: rgba(255, 200, 60, 0.1);
}

.leaderboard-rank {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgba(255, 200, 60, 0.85);
    width: 32px;
    min-width: 32px;
    -unity-text-align: middle-left;
}

.leaderboard-name {
    font-size: 14px;
    color: rgba(220, 225, 240, 0.85);
    flex-grow: 1;
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
}

.leaderboard-score {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(255, 200, 60);
    -unity-text-align: middle-right;
    min-width: 36px;
}

/* ═══════════ GAME OVER ═══════════ */
.overlay-game-over {
    background-color: rgba(10, 5, 18, 0.78);
}

.game-over-card {
    flex-direction: column;
    align-items: center;
    padding: 8% 10%;
    background-color: rgba(18, 10, 32, 0.95);
    border-width: 3px;
    border-color: rgba(255, 200, 60, 0.5);
    border-radius: 28px;
    max-width: 380px;
    width: 78%;
}

.game-over-score {
    font-size: 60px;
    -unity-font-style: bold;
    color: rgb(255, 220, 60);
    -unity-text-align: middle-center;
    text-shadow: 0 4px 0 rgb(50, 25, 0), 0 0 28px rgba(255, 180, 0, 0.3);
    letter-spacing: 2px;
    margin-bottom: -4px;
}

.game-over-score-sub {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgba(255, 220, 60, 0.6);
    letter-spacing: 6px;
    -unity-text-align: middle-center;
    margin-bottom: 12px;
}

.game-over-stat-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
}

.game-over-height {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(180, 220, 255);
    -unity-text-align: middle-center;
    text-shadow: 0 2px 0 rgb(15, 30, 60), 0 0 14px rgba(100, 180, 255, 0.25);
    letter-spacing: 1px;
}

.game-over-divider {
    width: 60%;
    height: 2px;
    background-color: rgba(255, 200, 60, 0.22);
    border-radius: 1px;
    margin-bottom: 18px;
}

.game-over-restart-btn {
    width: 100%;
    background-color: rgba(255, 200, 60, 0.18);
    border-width: 2px;
    border-color: rgba(255, 200, 60, 0.6);
    border-radius: 18px;
    padding: 14px 10px;
    transition-property: background-color, scale, border-color;
    transition-duration: 0.12s;
}

.game-over-restart-btn:hover {
    background-color: rgba(255, 200, 60, 0.35);
    border-color: rgb(255, 220, 100);
    scale: 1.04 1.04;
}

.game-over-restart-btn:active {
    background-color: rgba(255, 200, 60, 0.5);
    scale: 0.95 0.95;
}

.game-over-restart-label {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    letter-spacing: 4px;
    -unity-text-align: middle-center;
}

/* ═══════════ IN-GAME HUD ═══════════ */
.game-hud {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* score top-right */
.score-wrap {
    position: absolute;
    right: 4%;
    top: 3%;
    flex-direction: column;
    align-items: flex-end;
}

.score-label {
    font-size: 38px;
    -unity-font-style: bold;
    color: rgb(255, 220, 60);
    -unity-text-align: upper-right;
    text-shadow: 2px 3px 0 rgb(40, 20, 0), 0 0 14px rgba(255, 180, 0, 0.35);
}

.score-sub-label {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgba(255, 220, 60, 0.55);
    letter-spacing: 4px;
    margin-top: -4px;
    -unity-text-align: upper-right;
}

/* altitude top-left */
.altitude-hud-wrap {
    position: absolute;
    left: 4%;
    top: 3%;
    align-items: flex-start;
}

.altitude-label {
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(210, 235, 255);
    -unity-text-align: upper-left;
    text-shadow: 2px 3px 0 rgb(15, 25, 55), 0 6px 16px rgb(40, 70, 140);
}


/* combo root */
.combo-root {
    flex-grow: 1;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding-top: 16%;
}

/* live flip counter */
.live-flip-wrap {
    position: absolute;
    left: 0;
    right: 0;
    top: 10%;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
}

.live-flip-bar {
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
}

.live-flip-label {
    font-size: 72px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(255, 245, 180);
    text-shadow: 0 4px 0 rgb(20, 20, 50), 0 10px 30px rgb(140, 60, 200);
}

.live-flip-label.tier-live-zero {
    font-size: 46px;
    opacity: 0.45;
    color: rgb(180, 200, 220);
}

.live-flip-label.tier-low {
    font-size: 64px;
    color: rgb(120, 220, 255);
    text-shadow: 0 4px 0 rgb(10, 40, 60), 0 8px 22px rgb(60, 120, 200);
}

.live-flip-label.tier-mid {
    font-size: 72px;
    color: rgb(255, 220, 90);
}

.live-flip-label.tier-high {
    font-size: 82px;
    color: rgb(255, 90, 200);
    text-shadow: 0 6px 0 rgb(70, 0, 70), 0 12px 36px rgb(255, 100, 255);
}

.live-flip-meter {
    margin-top: 8px;
    width: 55%;
    height: 8px;
    border-radius: 4px;
    background-color: rgba(20, 15, 40, 0.6);
}

.live-flip-meter-fill {
    width: 0%;
    height: 100%;
    border-radius: 4px;
    background-color: rgb(255, 110, 200);
}

.live-flip-label.idle-flash {
    color: rgb(255, 140, 160);
}

/* combo popup */
.combo-popup-label {
    position: relative;
    font-size: 62px;
    -unity-font-style: bold;
    color: rgb(255, 240, 120);
    -unity-text-align: middle-center;
    text-shadow: 0 4px 0 rgb(30, 10, 60), 0 10px 28px rgb(180, 40, 200);
}

.combo-popup-label.tier-low {
    color: rgb(120, 220, 255);
    font-size: 56px;
    text-shadow: 0 4px 0 rgb(10, 40, 60), 0 8px 22px rgb(60, 120, 200);
}

.combo-popup-label.tier-mid {
    color: rgb(255, 220, 90);
    font-size: 62px;
}

.combo-popup-label.tier-high {
    color: rgb(255, 90, 200);
    font-size: 72px;
    text-shadow: 0 6px 0 rgb(70, 0, 70), 0 12px 32px rgb(255, 100, 255);
}
